prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "Invoke-WebRequest -Uri 'https://compass.llm.shopee.io/docs/INTEGRATIONS/claude-code' -UseBasicParsing | Select-Object -ExpandProperty Content"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "try { Invoke-WebRequest -Uri 'https://compass.llm.shopee.io/docs/INTEGRATIONS/claude-code' -UseBasicParsing -Headers @{ 'User-Agent'='Mozilla/5.0'; 'Accept'='text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8' } } catch { $resp = $_.Exception.Response; if ($resp -ne $null) { Write-Output ('STATUS: ' + [int]$resp.StatusCode.value__ + ' ' + $resp.StatusDescription); foreach ($k in $resp.Headers.Keys) { Write-Output ($k + ': ' + ($resp.Headers[$k] -join '; ')) }; $reader = New-Object System.IO.StreamReader($resp.GetResponseStream()); $body = $reader.ReadToEnd(); if ($body) { Write-Output 'BODY_START'; Write-Output $body; Write-Output 'BODY_END' } } else { Write-Output $_ } }"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$env:HTTP_PROXY=''; $env:HTTPS_PROXY=''; $env:ALL_PROXY=''; $html = Invoke-WebRequest -NoProxy -Uri 'https://compass.llm.shopee.io/docs/PLATFORM/openai-api-proxy' -UseBasicParsing | Select-Object -ExpandProperty Content; $pattern = '(gpt-[a-z0-9\\-]+(?:@[0-9]{8})?|o[134][a-z0-9\\-]*|omni-moderation-[a-z0-9\\-]+|text-embedding-[a-z0-9\\-]+|whisper-[a-z0-9\\-]+|tts-[a-z0-9\\-]+|gpt-image-[a-z0-9\\-]+)'; [regex]::Matches($html, $pattern) | ForEach-Object { $_.Value } | Sort-Object -Unique"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$env:HTTP_PROXY=''; $env:HTTPS_PROXY=''; $env:ALL_PROXY=''; $html = Invoke-WebRequest -NoProxy -Uri 'https://compass.llm.shopee.io/docs/PLATFORM/claude-api-proxy' -UseBasicParsing | Select-Object -ExpandProperty Content; [regex]::Matches($html, 'claude-[a-z0-9\\-]+@[0-9]{8}') | ForEach-Object { $_.Value } | Sort-Object -Unique"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$env:HTTP_PROXY=''; $env:HTTPS_PROXY=''; $env:ALL_PROXY=''; $html = Invoke-WebRequest -NoProxy -Uri 'https://compass.llm.shopee.io/docs/PLATFORM/openai-api-proxy' -UseBasicParsing | Select-Object -ExpandProperty Content; $pattern = '(gpt-[a-z0-9\\.\\-]+(?:@[0-9]{8})?|o[134][a-z0-9\\.\\-]*|omni-moderation-[a-z0-9\\.\\-]+|text-embedding-[a-z0-9\\.\\-]+|whisper-[a-z0-9\\.\\-]+|tts-[a-z0-9\\.\\-]+|gpt-image-[a-z0-9\\.\\-]+)'; [regex]::Matches($html, $pattern) | ForEach-Object { $_.Value } | Sort-Object -Unique"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$env:HTTP_PROXY=''; $env:HTTPS_PROXY=''; $env:ALL_PROXY=''; $html = Invoke-WebRequest -NoProxy -Uri 'https://compass.llm.shopee.io/docs/INTEGRATIONS/claude-code' -UseBasicParsing | Select-Object -ExpandProperty Content; @('opus','4.6','claude-opus','Supported models') | ForEach-Object { \"=== $_ ===\"; ($html | Select-String -Pattern $_ -CaseSensitive:$false -Context 0,3) | ForEach-Object { $_.Line; $_.Context.PostContext } }"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$env:HTTP_PROXY=''; $env:HTTPS_PROXY=''; $env:ALL_PROXY=''; $html = Invoke-WebRequest -NoProxy -Uri 'https://compass.llm.shopee.io/docs/PLATFORM/claude-api-proxy' -UseBasicParsing | Select-Object -ExpandProperty Content; @('opus','4.6','claude-opus','model-pricing','Supported models') | ForEach-Object { \"=== $_ ===\"; ($html | Select-String -Pattern $_ -CaseSensitive:$false -Context 0,3) | ForEach-Object { $_.Line; $_.Context.PostContext } }"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$ProgressPreference='SilentlyContinue'; $u='https://raw.githubusercontent.com/wshobson/agents/main/plugins/ui-design/settings.json'; try { (Invoke-WebRequest -UseBasicParsing $u).Content } catch { \"STATUS: $($_.Exception.Response.StatusCode.value__)\" }"], decision="allow")
